model Organization {
  id        String        @id @default(uuid())
  name      String
  ownerId   String
  owner     User          @relation("OrganizationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  branches  Branch[]
  roles     Role[]
  staff     StaffMember[]
  products  Product[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("organizations")
}

